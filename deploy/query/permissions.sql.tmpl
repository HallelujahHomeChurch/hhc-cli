-- REVIEW PREVIEW ONLY. Existing approved roles must be supplied by the DB owner.
-- Apply migration as SCHEMA_OWNER (non-login), with no untrusted CREATE in schema.
-- This file does not create a role, login, password, provider grant or secret.
ALTER FUNCTION hhc_query.lock_policy(text) OWNER TO ${SCHEMA_OWNER};
REVOKE ALL ON SCHEMA hhc_query FROM PUBLIC;
REVOKE ALL ON ALL TABLES IN SCHEMA hhc_query FROM PUBLIC;
REVOKE ALL ON FUNCTION hhc_query.lock_policy(text) FROM PUBLIC;
GRANT USAGE ON SCHEMA hhc_query TO ${RUNTIME_ROLE};
GRANT SELECT ON hhc_query.schema_version, hhc_query.broker_settings,
 hhc_query.caller_policy, hhc_query.quota_limit TO ${RUNTIME_ROLE};
GRANT EXECUTE ON FUNCTION hhc_query.lock_policy(text) TO ${RUNTIME_ROLE};
GRANT SELECT ON hhc_query.grant_state TO ${RUNTIME_ROLE};
GRANT UPDATE(generation,state,expires_at,ciphertext,rotation_started_at,updated_at)
 ON hhc_query.grant_state TO ${RUNTIME_ROLE};
GRANT SELECT,INSERT ON hhc_query.refresh_identity TO ${RUNTIME_ROLE};
GRANT SELECT,INSERT ON hhc_query.quota_usage TO ${RUNTIME_ROLE};
GRANT UPDATE(used) ON hhc_query.quota_usage TO ${RUNTIME_ROLE};
-- No runtime INSERT/DELETE grant_state, policy/quota-limit writes, schema CREATE,
-- settings changes, or UPDATE/DELETE of refresh_identity tombstones.
-- Owner provisioning and consent use an independently approved owner identity.
