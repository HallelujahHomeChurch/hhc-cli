# REVIEW PREVIEW ONLY. Render reviewed digest/host/namespace/identity settings before
# validation. No provider, cluster, credential, OAuth grant or paid resource is
# selected or provisioned by this template. Embedded PostgreSQL broker is included; actual identity/DB setup requires approval.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hhc-query
  namespace: ${NAMESPACE}
spec:
  replicas: 2
  minReadySeconds: 10
  progressDeadlineSeconds: 300
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels: {app: hhc-query}
  template:
    metadata:
      labels: {app: hhc-query}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 45
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule
          labelSelector:
            matchLabels: {app: hhc-query}
      containers:
        - name: query
          image: ${QUERY_IMAGE_DIGEST}
          ports: [{name: http, containerPort: 8080}]
          env:
            - {name: HHC_QUERY_CONFIG, value: /etc/hhc-query/config.json}
            - name: HHC_QUERY_RUNTIME_SECRET
              valueFrom:
                secretKeyRef:
                  name: ${APPROVED_RUNTIME_SECRET_NAME}
                  key: runtime.json
          resources:
            requests: {cpu: 100m, memory: 64Mi}
            limits: {cpu: '1', memory: 256Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: config, mountPath: /etc/hhc-query, readOnly: true}
          livenessProbe:
            httpGet:
              path: /health/live
              port: http
              httpHeaders: [{name: Host, value: hhc-query}]
          readinessProbe:
            httpGet:
              path: /health/ready
              port: http
              httpHeaders: [{name: Host, value: hhc-query}]
            timeoutSeconds: 3
      volumes:
        - name: config
          configMap:
            name: hhc-query-config
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: hhc-query-config
  namespace: ${NAMESPACE}
data:
  config.json: |
    {"resourceUrl":"https://${QUERY_HOST}/mcp","issuer":"${APPROVED_ISSUER}","introspectionUrl":"${APPROVED_INTROSPECTION_URL}","requiredScope":"${APPROVED_QUERY_SCOPE}","clientId":"${APPROVED_RESOURCE_CLIENT_ID}","hosts":["${QUERY_HOST}","hhc-query"],"origins":[]}

---
apiVersion: v1
kind: Service
metadata:
  name: hhc-query
  namespace: ${NAMESPACE}
spec:
  selector: {app: hhc-query}
  ports: [{name: http, port: 8080, targetPort: http}]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: hhc-query
  namespace: ${NAMESPACE}
spec:
  minAvailable: 1
  selector:
    matchLabels: {app: hhc-query}
